# Токен бота от @BotFather
TELEGRAM_TOKEN=

# Прокси до api.telegram.org (http://host:port или socks5://host:port); пусто = напрямую
TELEGRAM_PROXY=http://127.0.0.1:2080

# RabbitMQ
AMQP_URL=amqp://127.0.0.1

# Каталог для логов входящих сообщений (PII!) — см. logger/Messages.mjs
TELEGRAM_LOGGER_DIR=./msglog

# Имена очередей — должны совпадать с конфигом BFF (server/config.js)
AMQP_BOT_QUEUE=crm_untyped_net_bot
AMQP_AUTH_QUEUE=crm_bot_auth
