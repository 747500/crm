{
  "name": "crm",
  "version": "1.0.0",
  "description": "CRM monorepo: BFF + GraphQL backend + Telegram bot + legacy SPA + web (Vue3) + e2e",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/747500/crm.git"
  },
  "main": "server/server.mjs",
  "scripts": {
    "build": "npm run build -w @crm/web",
    "serve": "node --env-file-if-exists=.env server/server.mjs",
    "serve:graphql": "npm run serve -w @crm/graphql-mongodb",
    "serve:bot": "npm run serve -w @crm/telegram-bot",
    "serve:external": "npm run serve -w @crm/external",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "npm run test -w @crm/e2e",
    "ws:list": "npm ls --workspaces --depth=0"
  },
  "dependencies": {
    "amqplib": "^0.10.4",
    "connect-mongo": "^4.4.1",
    "connect-mongodb-session": "^2.4.1",
    "cookie-parser": "^1.4.5",
    "express": "4",
    "express-session": "^1.17.2",
    "graphql": "^15.5.1",
    "moment": "2",
    "mongodb": "^3.6.11",
    "mongoose": "^5.13.7",
    "morgan": "1",
    "mysql": "2",
    "sharp": "^0.28.3",
    "sphinxapi": "1"
  },
  "devDependencies": {
    "vitest": "^2.1.8",
    "vue": "^3.5.13"
  },
  "keywords": [
    "crm"
  ],
  "author": "serge r",
  "license": "WTFPL"
}
